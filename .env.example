# Exchange configuration (ccxt exchange id, e.g. binance, kraken, bybit)
EXCHANGE=binance

# API credentials (leave empty while DRY_RUN=true)
API_KEY=
API_SECRET=

# Trading pairs (comma separated) and timeframe, tracked and traded in parallel
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT
TIMEFRAME=1h

# Strategy parameters
FAST_MA=20
SLOW_MA=50

# Regime filter: only open new positions while price is above this long moving average
TREND_FILTER_MA=200

# Position sizing: quote currency amount spent per BUY order, PER SYMBOL.
# E.g. with 5 symbols and TRADE_AMOUNT_QUOTE=20, max total exposure if all
# symbols are in position at once is 5 x 20 = 100.
TRADE_AMOUNT_QUOTE=20

# Risk management: close the position early if price moves this % against/in favor of entry
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10

# Safety switch: when true, no real orders are sent, trades are only logged
DRY_RUN=true

# Loop interval in seconds between each check
POLL_INTERVAL_SECONDS=300

# Momentum rotation (python -m src.rotation): scan the market, hold the strongest coins
QUOTE_CURRENCY=USDT
UNIVERSE_SIZE=40
ROTATION_TIMEFRAME=1d
ROTATION_CANDLES=700
MOMENTUM_LOOKBACK=30
HOLD_PERIODS=7
TOP_K=5
