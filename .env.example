# Exchange configuration (ccxt exchange id, e.g. binance, kraken, bybit)
EXCHANGE=binance

# API credentials (leave empty while DRY_RUN=true)
API_KEY=
API_SECRET=

# Trading pair and timeframe
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Strategy parameters
FAST_MA=20
SLOW_MA=50

# Position sizing: quote currency amount spent per BUY order
TRADE_AMOUNT_QUOTE=50

# Risk management: close the position early if price moves this % against/in favor of entry
STOP_LOSS_PCT=5
TAKE_PROFIT_PCT=10

# Safety switch: when true, no real orders are sent, trades are only logged
DRY_RUN=true

# Loop interval in seconds between each check
POLL_INTERVAL_SECONDS=300
